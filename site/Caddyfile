{
	auto_https off
}

:80 {
	root * /var/www/html
	file_server
	encode gzip

	# Fully static multipage site: unknown paths fall through to a real
	# 404 (no SPA-style homepage rewrite — that masks broken links as
	# soft-404s and breaks indexing/debugging).
	try_files {path} {path}/index.html {path}.html

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
